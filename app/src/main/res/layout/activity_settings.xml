<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:descendantFocusability="blocksDescendants"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- API Key -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/apiKeyLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="@string/api_key_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/apiKeyEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:hint="@string/api_key_hint" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- API Base URL -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="@string/api_base_url_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/apiBaseUrlEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:hint="@string/api_base_url_hint" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 模型名称 -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:hint="@string/model_name_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/modelNameEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:hint="@string/model_name_hint" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 人格风格 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/personalityLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/personality_label"
                android:layout_marginBottom="32dp">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/personalityDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:inputType="none"
                    android:gravity="start|center_vertical"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 保存按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveButton"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/save"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/orange_primary"
                app:cornerRadius="12dp" />

            <!-- 提示 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="需要在 DeepSeek 官网 (platform.deepseek.com) 注册并创建 API Key。"
                android:textSize="12sp"
                android:textColor="@color/text_hint"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginTop="24dp"
                android:gravity="center" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
